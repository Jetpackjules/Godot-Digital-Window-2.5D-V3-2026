[node name="ProjectedWindowFrameV5" type="Node3D"]
editor_description = "V5 calibrated projective photograph on clean, deterministic geometry. The photograph remains exact at the authored center eye. Five smooth pier profiles and a shallow sill provide restrained parallax; dark aperture returns appear only from off-axis views. V4 and the active Gaussian view are unchanged."
