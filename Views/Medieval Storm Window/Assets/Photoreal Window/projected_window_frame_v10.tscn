[node name="ProjectedWindowFrameV10" type="Node3D"]
editor_description = "V10 preserves V9 as a fallback. Its deeper masonry body and capital sockets remove the wafer edge; contour-clipped facade triangles, smoothed opening outlines, shallow tracery bevels and complete pillar exclusions remove the mould overflow and floating return strips seen at oblique head poses."
script = ExtResource("1_script")
projected_material = SubResource("ShaderMaterial_front")
pillar_projected_material = SubResource("ShaderMaterial_pillar_front")
aperture_return_material = SubResource("ShaderMaterial_return")
concealed_closure_material = SubResource("ShaderMaterial_closure")

